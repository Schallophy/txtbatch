{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "txtbatch",
  "version": "0.1.0",
  "identifier": "com.schallophy.txtbatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "txtbatch - 批量文本工具",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
